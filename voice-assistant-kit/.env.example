# Copy to backend/.env — never commit real values. Server-side only.
APP_ENV=dev
LOG_LEVEL=INFO
DOMAIN_PACK=farm_marketplace
TOOL_MODE=mock                       # mock | live

# --- Supabase / Postgres (assistant's own schema `voice`) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DB_STATEMENT_CACHE_SIZE=0            # required with transaction-mode pooling
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=                   # check Supabase docs for your project's current verification method
SUPABASE_JWT_SECRET=                 # legacy projects only

# --- AI providers (selected by name; adapters live in voice_core/adapters) ---
LLM_PROVIDER=openai_compat           # openai_compat | sarvam | gemini | anthropic | fake
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=12

STT_PROVIDER=sarvam
STT_MODEL=saaras:v3                  # verify current id in Sarvam docs
STT_MODE=transcribe
TTS_PROVIDER=sarvam
TTS_MODEL=bulbul:v3                  # verify current id in Sarvam docs
SARVAM_API_KEY=

EMBEDDING_PROVIDER=local             # local | openai_compat | fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024                   # must match supabase/migrations vector(1024)
AUTO_RAG_MIN_SIM=0.45

# --- Host app backend used by live tool handlers ---
HOST_API_BASE_URL=http://localhost:9000
HOST_API_AUTH_MODE=forward_user_jwt  # forward_user_jwt | service_token
HOST_API_SERVICE_TOKEN=

# --- Limits & privacy ---
MAX_UTTERANCE_SECONDS=30
RATE_LIMIT_TURNS_PER_MIN=20
RATE_LIMIT_TURNS_PER_DAY=300
STORE_AUDIO=false
TRANSCRIPT_RETENTION_DAYS=90
