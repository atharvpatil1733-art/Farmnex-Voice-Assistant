# Copy to backend/.env — never commit real values. Server-side only.
APP_ENV=dev
LOG_LEVEL=INFO
DOMAIN_PACK=farm_marketplace
TOOL_MODE=mock                       # mock | live

# --- Supabase / Postgres (assistant's own schema `voice`) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DB_STATEMENT_CACHE_SIZE=0            # required with transaction-mode pooling
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=                   # check Supabase docs for your project's current verification method
SUPABASE_JWT_SECRET=                 # legacy projects only

# --- AI providers (selected by name; adapters live in voice_core/adapters) ---
# Fallback-chain mode (recommended): tries each "provider:model" entry in order, falling
# through to the next only if one fails before producing any output (never mid-answer).
# Leave empty to fall back to the single-provider LLM_PROVIDER/LLM_MODEL block below instead.
# Verify current model ids/limits before relying on this long-term — free-tier lineups change:
# ai.google.dev/gemini-api/docs/models and console.groq.com/docs/models.
LLM_FALLBACK_CHAIN=gemini:gemini-2.5-flash,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,groq:openai/gpt-oss-20b
GEMINI_API_KEY=                      # paste your Gemini key from aistudio.google.com here
GROQ_API_KEY=                        # paste your Groq key from console.groq.com here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Single-provider mode (used only when LLM_FALLBACK_CHAIN is empty)
LLM_PROVIDER=openai_compat           # openai_compat | gemini | fake
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=12

STT_PROVIDER=sarvam
STT_MODEL=saaras:v3                  # verify current id in Sarvam docs
STT_MODE=transcribe
TTS_PROVIDER=sarvam
TTS_MODEL=bulbul:v3                  # verify current id in Sarvam docs
SARVAM_API_KEY=

EMBEDDING_PROVIDER=gemini            # gemini | fake  (uses GEMINI_API_KEY; "local" has no adapter yet)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024                   # must match supabase/migrations vector(1024)
AUTO_RAG_MIN_SIM=0.45

# --- Host app backend used by live tool handlers ---
HOST_API_BASE_URL=http://localhost:9000
HOST_API_AUTH_MODE=forward_user_jwt  # forward_user_jwt | service_token
HOST_API_SERVICE_TOKEN=

# --- Limits & privacy ---
MAX_UTTERANCE_SECONDS=30
RATE_LIMIT_TURNS_PER_MIN=20
RATE_LIMIT_TURNS_PER_DAY=300
STORE_AUDIO=false
TRANSCRIPT_RETENTION_DAYS=90
